Global Process Input_MagicInfoLite()
    SelectedInput := 11
    InputRevision += 1
    InputCaption := "Požadovaný vstup: MagicInfoLite"
    RaiseEvent InputSelectionChanged(SelectedInput)
    RaiseEvent AVStateChanged(PowerCaption, InputCaption)
    StartProcess SendInput(11, InputRevision)
End Process

// TCP runs separately from the shared selection and its UI events.
// Discard obsolete queued selections; never overwrite a newer UI selection.
Private Process SendInput(inputid As Long, revision As Long)
    InputSendLock.Lock()
    If revision = InputRevision Then
        Select inputid
            Case 1
                SamsungMonitor1.Input_HDMI_1()
            Case 2
                SamsungMonitor1.Input_HDMI_2()
            Case 3
                SamsungMonitor1.Input_DisplayPort_1()
            Case 4
                SamsungMonitor1.Input_VGA_1()
            Case 5
                SamsungMonitor1.Input_DVI_1()
            Case 6
                SamsungMonitor1.Input_Component_1()
            Case 7
                SamsungMonitor1.Input_BNC_1()
            Case 8
                SamsungMonitor1.Input_Composite_1()
            Case 9
                SamsungMonitor1.Input_Svideo_1()
            Case 10
                SamsungMonitor1.Input_MagicInfo()
            Case 11
                SamsungMonitor1.Input_MagicInfoLite()
        End Select
    End If
    InputSendLock.Unlock()
End Process

Global Process PowerOn()
    PowerCaption := "Požadavek: zapnout monitor"
    RaiseEvent AVStateChanged(PowerCaption, InputCaption)
    StartProcess SendPowerOn()
End Process

Private Process SendPowerOn()
    SamsungMonitor1.PowerOn()
End Process

Global Process PowerOff()
    PowerCaption := "Požadavek: vypnout monitor"
    RaiseEvent AVStateChanged(PowerCaption, InputCaption)
    StartProcess SendPowerOff()
End Process

Private Process SendPowerOff()
    SamsungMonitor1.PowerOff()
End Process






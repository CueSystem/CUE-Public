Private Var SelectedInput As Long := 0
Private Var InputRevision As Long := 0
Private Var InputSendLock As _Semaphore
Private Var PowerCaption As Text[128] := "Monitor: stav neznámý"
Private Var InputCaption As Text[128] := "Vstup: dosud nezvolen"
Global Event InputSelectionChanged As Process(inputid As Long)
Global Event AVStateChanged As Process(powertext As Text, inputtext As Text)

Global Process ReportState()
    RaiseEvent InputSelectionChanged(SelectedInput)
    RaiseEvent AVStateChanged(PowerCaption, InputCaption)
End Process

Private Process PowerFeedback(status As Long) Link SamsungMonitor1.OnPowerStatusChange
    If status = 1 Then
        PowerCaption := "Monitor: zapnutý"
    Else
        If status = 0 Then
            PowerCaption := "Monitor: vypnutý"
        Else
            PowerCaption := "Monitor: stav neznámý"
        End If
    End If
    RaiseEvent AVStateChanged(PowerCaption, InputCaption)
End Process

Global Process Input_HDMI_1()
    SelectedInput := 1
    InputRevision += 1
    InputCaption := "Požadovaný vstup: HDMI 1"
    RaiseEvent InputSelectionChanged(SelectedInput)
    RaiseEvent AVStateChanged(PowerCaption, InputCaption)
    StartProcess SendInput(1, InputRevision)
End Process

Global Process Input_HDMI_2()
    SelectedInput := 2
    InputRevision += 1
    InputCaption := "Požadovaný vstup: HDMI 2"
    RaiseEvent InputSelectionChanged(SelectedInput)
    RaiseEvent AVStateChanged(PowerCaption, InputCaption)
    StartProcess SendInput(2, InputRevision)
End Process


Global Class _TcpClient BuiltIn(11)
    Global Function Connect(serveraddress As Text, serverport As Long, Optional timeout As Time := :10.0) As Boolean BuiltIn(40) End Function
    Global Function Send(datatosend As ByteString) As Boolean BuiltIn(41) End Function
    Global Function Receive(ByRef receiveddata As ByteString, Optional timeout As Time:= :10.0, Optional  maxbytestoreceive As Long:= 0) As Boolean BuiltIn(42) End Function
    Global Function Disconnect() BuiltIn(43) End Function
    Global Function ClearReceiveBuffer() BuiltIn(44) End Function
    Global Function GetMyIpAddress(ByRef ipaddress As Text, ByRef port As Long) As Boolean BuiltIn(143) End Function
    Global Function ReceiveAnything(ByRef receiveddata As ByteString, Optional timeout As Time := :10.0) As Boolean BuiltIn(152) End Function
    Global Function ReceiveAppend(ByRef receivebuffer As ByteString, Optional timeout As Time := :10.0) As Boolean BuiltIn(153) End Function
    Global Function ReceiveHFPacket(ByRef receivedbody As ByteString, header As ByteString, footer As ByteString, Optional timeout As Time := :10.0) As Boolean BuiltIn(93) End Function
    Global Function WaitForData(Optional timeout As Time :=  :10.0) As Boolean BuiltIn(161) End Function
    Global Function ReceiveHLPacket(ByRef receivedbody As ByteString, header As ByteString, bodylength As Long, Optional timeout As Time := :10.0 ) As Boolean BuiltIn(164) End Function
    Global Function ReceiveFPacket(ByRef receivedbody As ByteString, footer As ByteString, Optional timeout As Time := :10.0 ) As Boolean BuiltIn(167) End Function
    Global Function ReceiveSyncFrame(syncframe As ByteString, Optional timeout As Time := :10.0 ) As Boolean BuiltIn(171) End Function
    Global Function ConnectSSL(serveraddress As Text, serverport As Long, Optional timeout As Time := :10.0) As Boolean BuiltIn(426) End Function
